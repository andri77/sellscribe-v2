{
  "consumer": {
    "name": "sellscribe-app"
  },
  "interactions": [
    {
      "description": "a full generate-listing request",
      "pending": false,
      "providerStates": [
        {
          "name": "OpenAI returns a valid listing"
        }
      ],
      "request": {
        "body": {
          "content": {
            "category": "Electronics",
            "imageUrls": [
              "https://example.supabase.co/storage/v1/object/public/product-images/u1/charger.jpg"
            ],
            "keyFeatures": "Eco-friendly, Fast 15W charging, LED indicator",
            "productName": "Bamboo Wireless Charger",
            "targetAudience": "Tech enthusiasts who care about sustainability",
            "tone": "professional"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Authorization": [
            "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ1c2VyIn0.example-user"
          ],
          "Content-Type": [
            "application/json"
          ],
          "apikey": [
            "eyJhbGciOiJIUzI1NiJ9.eyJyb2xlIjoiYW5vbiJ9.example-anon"
          ]
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer [\\w-]+\\.[\\w-]+\\.[\\w-]+$"
                }
              ]
            },
            "apikey": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[\\w-]+\\.[\\w-]+\\.[\\w-]+$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/functions/v1/generate-listing"
      },
      "response": {
        "body": {
          "content": {
            "bullets": [
              "Fast 15W wireless charging"
            ],
            "description": "<p>Eco-friendly fast charging solution.</p>",
            "tags": [
              "wireless-charger"
            ],
            "title": "Premium Bamboo Wireless Charger — Fast Qi Charging"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.bullets": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.description": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.tags": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^.{1,70}$"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
